# All application PHP files are PHP, not Hack.
*.php linguist-language=PHP

# Third-party Thai province data and its import/export scripts.
# Keep these files available to the app, but exclude them from language stats.
thai-province-data-master/** linguist-vendored=true linguist-detectable=false
typescript/frontend/public/thai-province-data-master/** linguist-vendored=true linguist-detectable=false

# npm generates these dependency lock files.
package-lock.json linguist-generated
