# ==========================================
# Application Configuration (.env.example)
# Duplicate this file as .env and adjust variables
# ==========================================

APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true

# Database Credentials
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pabpla_demo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session Lifetime (seconds, 7200 = 2 hours)
SESSION_LIFETIME=7200

# DPT Single Sign-On (OIDC / OAuth2)
SSO_BASE_URL=https://sso.dpt.go.th/openId/public
SSO_CLIENT_ID=your_client_id_here
SSO_CLIENT_SECRET=your_client_secret_here
SSO_REDIRECT_URL=https://info.dpt.go.th/prasan-phithi
SSO_SCOPE="openid profile email"

