# Protect sensitive configuration, environment files, and database dumps
<FilesMatch "^\.env|\.(sql|sqlite|log|ini|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory indexing
Options -Indexes

# Set UTF-8 encoding default
AddDefaultCharset UTF-8
