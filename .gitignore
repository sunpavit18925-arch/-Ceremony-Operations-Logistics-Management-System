# Environment configuration
.env
.env.*
!.env.example

# Private keys and local credentials
*.pem
*.key
*.p12
*.pfx
*.jks
.aws/
.codex/

# Real database dumps containing sensitive agency records
*.sql
*.sql.gz
*.sql.bak
*.dump
*.sqlite
*.sqlite3
*.db
*.bak

# Allow the application schema, synthetic demo seeds, and public province data
!/database/schema.sql
!/database/seeds.sql
!**/thai-province-data-master/formats/sql/*.sql

# Uploaded documents (retain directory protection and gitkeeps)
/uploads/**
!/uploads/**/
!/uploads/**/.htaccess
!/uploads/**/.gitkeep

# Temporary test uploads
/tests/test_uploads/*
!/tests/test_uploads/.htaccess
!/tests/test_uploads/.gitkeep

# Dependencies and generated build/test output
node_modules/
.next/
dist/
dist-tests/
coverage/
.nyc_output/
*.tsbuildinfo
next-env.d.ts
.vercel/
playwright-report/
test-results/

# Error logs and temp files
*.log
error_log
php_errors.log
*.tmp
*.temp
*.swp
*~

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace


# Local archive of unused files
/backup/
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Downloaded comparison project and old local TypeScript copies
/pabpla_test3/
/typescript/backend tsx/
/typescript/frontend tsx/

# Local screenshots and unused large legacy artwork
/img/
/images/happy.png

# Machine-specific comparison and archive reports
/tools/*-report.json
